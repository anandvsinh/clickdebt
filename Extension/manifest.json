{
  "manifest_version": 3,
  "name": "ClickDebt",
  "version": "1.0",
  "description": "Tracks website usage time with live updates",
  "permissions": ["tabs", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}